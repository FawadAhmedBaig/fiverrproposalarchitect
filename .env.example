# Environment Variables — Required for deployment
# Copy this file to .env.local and fill in your values

# Paddle v2 Billing
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_CLIENT_TOKEN=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_PRICE_ID=pri_01hxxxxxxxxxxxxxxxxxxxxxxxxxx
PADDLE_ENVIRONMENT=sandbox

# Firebase Admin SDK
# Paste the ENTIRE JSON content of your Firebase service account key as a single line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}
